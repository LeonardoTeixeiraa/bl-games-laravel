{$SITE_ADDRESS:http://localhost} {
    encode zstd gzip
    request_body {
        max_size 12MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @backend path /api /api/* /up
    handle @backend {
        root * /var/www/html/public
        php_fastcgi backend:9000
    }
    handle_path /storage/* {
        root * /srv/uploads
        file_server
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
    log
}

# Internal HTTP probe verifies Caddy and Laravel without depending on public DNS/TLS.
:8080 {
    bind 127.0.0.1
    root * /var/www/html/public
    php_fastcgi backend:9000
}
